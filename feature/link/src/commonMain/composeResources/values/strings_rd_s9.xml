    <string name="rd_s9_link_map_description">Link map: %1$s connected to %2$s</string>
    <string name="rd_s9_link_none_body">On the PC open Nijiyome › Link › Pair device and scan the code, or paste it.</string>
    <string name="rd_s9_link_pair_expired_title">The pairing code expired</string>
    <string name="rd_s9_link_pair_expired_body">Codes last a few minutes and work once. On the PC press Pair device again and scan the new code.</string>
    <string name="rd_s9_link_pair_wrong_title">The code does not match</string>
    <string name="rd_s9_link_pair_wrong_body">Check it against the one the PC shows now and try again.</string>
    <string name="rd_s9_link_pair_toomany_title">Too many attempts</string>
    <string name="rd_s9_link_pair_toomany_body">The PC paused pairing for a while. Wait a minute and ask it for a new code.</string>
    <string name="rd_s9_link_pair_unreachable_title">The PC did not answer</string>
    <string name="rd_s9_link_pair_unreachable_body">Check that both are on the same network and that Link is on in the PC.</string>
    <string name="rd_s9_link_paste_clipboard">Paste from clipboard</string>
    <string name="rd_s9_link_why_title">Why link this phone with the PC?</string>
    <string name="rd_s9_link_why_1">The PC enhances the video (Anime4K, extra frames) and sends it ready.</string>
    <string name="rd_s9_link_why_2">The history syncs between both.</string>
    <string name="rd_s9_link_why_3">What you watch on the PC you can continue here, and the other way round.</string>
    <string name="rd_s9_link_why_4">It uses the network and the power of the PC while you watch.</string>
    <string name="rd_s9_link_why_5">It only works on your network or through a secure tunnel such as Tailscale.</string>
    <string name="rd_s9_link_tip_wifi">Check that this phone is on the same Wi-Fi as the PC.</string>
    <string name="rd_s9_link_tip_open">On the PC, open Nijiyome and check that Link is on.</string>
    <string name="rd_s9_link_tip_tunnel">Away from home, use a secure tunnel such as Tailscale.</string>

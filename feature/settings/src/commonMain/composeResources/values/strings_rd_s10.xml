    <string name="rd_s10_onb_sources">Sources</string>
    <string name="rd_s10_onb_link">Link and system</string>
    <string name="rd_s10_onb_step_of">Step %1$d of %2$d</string>
    <string name="rd_s10_onb_look_title">Hi. Let us set Nijiyome up your way.</string>
    <string name="rd_s10_onb_look_body">Everything here can be changed later in Settings.</string>
    <string name="rd_s10_onb_theme">Theme</string>
    <string name="rd_s10_onb_list_title">Your list and how you watch</string>
    <string name="rd_s10_onb_how_you_watch">How you like to watch</string>
    <string name="rd_s10_onb_sources_title">Choose your first sources</string>
    <string name="rd_s10_onb_sources_body">Nijiyome brings no content. Extensions find episodes and chapters where you choose.</string>
    <string name="rd_s10_onb_sources_where">Extensions live in Sources</string>
    <string name="rd_s10_onb_link_title">Link and system</string>
    <string name="rd_s10_onb_link_body">Optional. Your PC can enhance the video for your phone and lend it its extensions.</string>
    <string name="rd_s10_link_moved">Pairing, devices, ports, cache, library folder, firewall and the extension server are on the Link screen.</string>
    <string name="rd_s10_link_open_screen">Open Nijiyome Link</string>
    <string name="rd_s10_motion_master_hint">Off stops every animation in the app, the same as Reduce motion. Subtle keeps the older effects (carousels, page changes) to fades. How the redesign moves is the profile above.</string>
    <string name="rd_s10_motion_off_note">Animations are off: the profile applies when you turn them back on.</string>
    <string name="rd_s10_appearance_pages">Appearance sections</string>
    <string name="rd_s10_design_hanging_tilt">Tilted strips at rest</string>
    <string name="rd_s10_design_hanging_tilt_hint">Hanging tanzaku cards rest slightly tilted, each its own way, like papers on a cord. Only with full motion.</string>
    <string name="rd_s10_tonight_layout">Tonight</string>
    <string name="rd_s10_tonight_layout_hint">How the Home row with what you follow, what aired today and what airs later is laid out.</string>
    <string name="rd_s10_tonight_featured">Featured and list</string>
    <string name="rd_s10_tonight_featured_desc">What to watch now as a big card, the rest on an agenda sheet beside it.</string>
    <string name="rd_s10_tonight_wide">Like New episodes</string>
    <string name="rd_s10_tonight_wide_desc">The big skinned card on one branch, with arrows to move along.</string>
    <string name="rd_s10_tonight_grid">Grid</string>
    <string name="rd_s10_tonight_grid_desc">Medium cards on up to two branches; if there are more, the last one opens the full list.</string>
    <string name="rd_s10_tonight_branches">Three branches</string>
    <string name="rd_s10_tonight_branches_desc">One branch to continue, one for what aired today and one for what airs later.</string>
    <string name="rd_s10_tonight_night">The night on a branch</string>
    <string name="rd_s10_tonight_night_desc">The branch is the clock: aired on the left, a lantern at "now" and what comes next on the right.</string>
    <string name="rd_s10_motion_extras">Animations</string>
    <string name="rd_s10_motion_extras_hint">Pick the ones you want. Each follows the motion profile and turns off when you ask to reduce motion.</string>
    <string name="rd_s10_mx_wheel">Smooth wheel scrolling</string>
    <string name="rd_s10_mx_wheel_desc">Each notch goes further and eases to a stop; chained notches keep their momentum. Touchpads are unchanged.</string>
    <string name="rd_s10_mx_bars">Thin scrollbars</string>
    <string name="rd_s10_mx_bars_desc">They show while you scroll and widen when the pointer comes close.</string>
    <string name="rd_s10_mx_arrows">Arrows on rows</string>
    <string name="rd_s10_mx_arrows_desc">They appear when the pointer is over a row of cards and move one page.</string>
    <string name="rd_s10_mx_images">Images fade in</string>
    <string name="rd_s10_mx_images_desc">Posters and banners appear softly when they load instead of popping in.</string>
    <string name="rd_s10_mx_content">Content appears softly</string>
    <string name="rd_s10_mx_content_desc">What finishes loading replaces the placeholder with a short fade.</string>
    <string name="rd_s10_mx_lists">Lists that rearrange</string>
    <string name="rd_s10_mx_lists_desc">When you filter, add or remove, each item glides to its place.</string>
    <string name="rd_s10_mx_tabs">Sliding tabs</string>
    <string name="rd_s10_mx_tabs_desc">The new tab comes in from its side, with a fade.</string>
    <string name="rd_s10_mx_sections">Section changes</string>
    <string name="rd_s10_mx_sections_desc">When you switch main sections, the page fades out and the new one fades in.</string>
    <string name="rd_s10_mx_expand">Expand and collapse</string>
    <string name="rd_s10_mx_expand_desc">Synopsis, shelves and groups change height along a curve.</string>
    <string name="rd_s10_mx_rail">Sliding indicator</string>
    <string name="rd_s10_mx_rail_desc">The mark of the active rail item travels to the new item.</string>
    <string name="rd_s10_mx_lift">Lift on hover</string>
    <string name="rd_s10_mx_lift_desc">Material and Canon cards rise a little and gain a shadow.</string>
    <string name="rd_s10_mx_header">Headers that hide</string>
    <string name="rd_s10_mx_header_desc">On the phone, the top bar goes away as you scroll down and comes back as you scroll up.</string>
    <string name="rd_s10_mx_top">Tap again to go to the top</string>
    <string name="rd_s10_mx_top_desc">Tapping the section you are already in scrolls back to the top.</string>
</resources>
